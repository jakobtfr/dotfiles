# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${USER}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${USER}.zsh"
fi

# Everything in ~/.config/shell is sourced, including untracked files like local.zsh.
for file in ~/.config/shell/*.zsh(N.); do
  source "$file"
done

{{ if eq .chezmoi.os "darwin" -}}
p10k_dir=$HOMEBREW_PREFIX/share/powerlevel10k
plugin_dir=$HOMEBREW_PREFIX/share
{{- else -}}
p10k_dir=/usr/share/zsh-theme-powerlevel10k
plugin_dir=/usr/share/zsh/plugins
{{- end }}
for file in \
  $p10k_dir/powerlevel10k.zsh-theme \
  $plugin_dir/zsh-autosuggestions/zsh-autosuggestions.zsh \
  $plugin_dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
  [[ -r $file ]] && source $file
done
unset file p10k_dir plugin_dir

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
